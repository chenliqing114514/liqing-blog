	<p>
		&copy; {year} 立青 · 用 <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> 构建
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0;
	}
	footer a {
		color: rgb(var(--gray));
	}
</style>
